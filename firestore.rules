rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo voi due potete leggere e scrivere.
    function autorizzato() {
      return request.auth != null
        && request.auth.token.email in ['mazzuoccolo.fabio@gmail.com', 'stefaniapranzo211089@gmail.com'];
    }
    // Vale per tutte le sezioni dell'app (progetti, vendite, bobine, accessori, impostazioni)
    match /{collezione}/{documento} {
      allow read, write: if autorizzato();
    }
  }
}
